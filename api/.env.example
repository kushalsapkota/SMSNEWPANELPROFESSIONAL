# Required (CONTRACTS §1)
DATABASE_URL=postgres://sms_api_login:sms_api_dev@localhost:5432/sms_gateway
DATABASE_URL_PRIVILEGED=postgres://sms_engine_login:sms_engine_dev@localhost:5432/sms_gateway
REDIS_URL=redis://localhost:6399/0
INTERNAL_TOKEN=change-me-internal-token
ENGINE_URL=http://localhost:8081
# base64 of 32 random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENC_KEY=
# at least 32 characters
JWT_SECRET=

# Optional
PORT=3000
TRUST_PROXY=0
# Peers whose X-Forwarded-For is believed when TRUST_PROXY=1 (CIDRs/IPs, or loopback,linklocal,uniquelocal).
# The client IP is the right-most hop that is not one of these. Empty = loopback,linklocal,uniquelocal.
TRUSTED_PROXIES=
ENGINE_TIMEOUT_MS=5000
TOTP_ISSUER=SMS Gateway
REFRESH_TOKEN_TTL_DAYS=30
LEDGER_RECONCILE_INTERVAL_MS=30000
DB_POOL_MAX=20
CFG_INVALIDATE_CHANNEL=cfg:invalidate
# 1 = webhooks may target loopback/private/reserved addresses (SSRF guard off). Dev/tests only.
# The engine reads the same variable.
WEBHOOK_ALLOW_PRIVATE_TARGETS=0

# Public /v1 API
PUBLIC_API_RATE_LIMIT=100           # requests/second per API key
API_KEY_TOUCH_INTERVAL_MS=60000     # api_keys.last_used_at write throttle

# Background workers (0 disables the in-process timer)
CAMPAIGN_WORKER_INTERVAL_MS=1000
ALERTS_INTERVAL_MS=60000
ALERT_DEDUPE_SECONDS=21600          # one alert per org per condition per 6h

# Alert delivery: email when SMTP_HOST is set, Telegram when TELEGRAM_BOT_TOKEN is set
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org

# Engine Prometheus endpoint for /api/analytics/live tps_in (default: ENGINE_URL host, port 9100)
ENGINE_METRICS_URL=
# Swagger UI at /api/docs (JSON at /api/docs-json)
SWAGGER_ENABLED=1

# Seed only (npm run seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
