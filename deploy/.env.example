# deploy/.env: settings for deploy/docker-compose.prod.yml
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
#   docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env up -d --build
#
# Every REQUIRED value is empty here on purpose: compose refuses to start until it is set.
# Secrets that appear inside connection URLs (database and Redis passwords) MUST be URL-safe,
# so generate them as hex. Generate every secret like this:
#   openssl rand -hex 24                      → passwords / tokens (48 hex chars)
#   openssl rand -base64 32                   → APP_ENC_KEY (exactly 32 random bytes, base64)
#   openssl rand -hex 48                      → JWT_SECRET
# Fill them all at once:
#   sed -i "s|^POSTGRES_PASSWORD=$|POSTGRES_PASSWORD=$(openssl rand -hex 24)|; \
#           s|^SMS_API_DB_PASSWORD=$|SMS_API_DB_PASSWORD=$(openssl rand -hex 24)|; \
#           s|^SMS_ENGINE_DB_PASSWORD=$|SMS_ENGINE_DB_PASSWORD=$(openssl rand -hex 24)|; \
#           s|^REDIS_PASSWORD=$|REDIS_PASSWORD=$(openssl rand -hex 24)|; \
#           s|^INTERNAL_TOKEN=$|INTERNAL_TOKEN=$(openssl rand -hex 32)|; \
#           s|^APP_ENC_KEY=$|APP_ENC_KEY=$(openssl rand -base64 32)|; \
#           s|^JWT_SECRET=$|JWT_SECRET=$(openssl rand -hex 48)|" deploy/.env
# Back up APP_ENC_KEY separately and safely. Without it, the stored upstream SMPP passwords,
# webhook secrets and TOTP secrets cannot be decrypted.

# ---------------------------------------------------------------------------------------------
# Images / publishing
# ---------------------------------------------------------------------------------------------
# Image names: ${IMAGE_PREFIX}/engine|api|web:${IMAGE_TAG}. Set a registry prefix to push/pull.
IMAGE_PREFIX=smsgw
IMAGE_TAG=latest
# Host address web 3001 and api 3000 bind to. Keep 127.0.0.1: nginx on the same host terminates
# TLS for them (deploy/nginx.conf) and replaces X-Forwarded-For. 0.0.0.0 exposes them directly;
# then set TRUST_PROXY=0, because the web passes a client's own X-Forwarded-For through to the
# api and panel/API IP whitelists could be spoofed.
PUBLISH_ADDR=127.0.0.1
# Host address client SMPP 2775 binds to. 0.0.0.0 = public (the engine sees real peers, which
# SMPP IP whitelists need). Use 127.0.0.1 with SMPP_PUBLIC_PORT=12775 to put it behind nginx's
# stream block instead (peers then all appear as nginx).
SMPP_PUBLISH_ADDR=0.0.0.0
# Host ports (container ports are fixed: web 3001, api 3000, SMPP 2775).
WEB_PUBLIC_PORT=3001
API_PUBLIC_PORT=3000
SMPP_PUBLIC_PORT=2775

# ---------------------------------------------------------------------------------------------
# PostgreSQL 16
# ---------------------------------------------------------------------------------------------
POSTGRES_DB=sms_gateway
# Owner / superuser. Only db-init (migrations, roles) and db-maint (partitions) use it.
POSTGRES_USER=sms_owner
# REQUIRED. openssl rand -hex 24
POSTGRES_PASSWORD=
# Login roles created by deploy/init/init-roles.sh (re-run db-init after changing a password:
#   docker compose ... up -d --force-recreate db-init engine api).
#   api tenant pool  → SMS_API_DB_USER    (member of sms_api, subject to RLS)
#   engine + api privileged pool → SMS_ENGINE_DB_USER (member of sms_engine, BYPASSRLS)
SMS_API_DB_USER=sms_api_login
# REQUIRED, URL-safe, >= 16 chars. openssl rand -hex 24
SMS_API_DB_PASSWORD=
SMS_ENGINE_DB_USER=sms_engine_login
# REQUIRED, URL-safe, >= 16 chars. openssl rand -hex 24
SMS_ENGINE_DB_PASSWORD=
# Server tuning (defaults suit a 4 GB host; shared_buffers ~25% RAM, effective_cache ~75%).
# max_connections must cover engine (ENGINE_DB_MAX_CONNS) + api (2 pools × API_DB_POOL_MAX)
# per replica, plus headroom.
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=16MB
# Log statements slower than this (ms). -1 disables.
PG_LOG_MIN_DURATION_MS=1000

# ---------------------------------------------------------------------------------------------
# Partition maintenance (db-maint service runs deploy/init/maintenance.sh)
# ---------------------------------------------------------------------------------------------
# Seconds between runs (default 6h; the job is idempotent).
MAINT_INTERVAL_SECONDS=21600
# Keep message_logs partitions this many months ahead of the current month.
MAINT_PARTITION_MONTHS=3
# Drop whole monthly partitions older than this (e.g. "13 months"). Empty = keep forever.
MESSAGE_LOG_RETENTION=

# ---------------------------------------------------------------------------------------------
# Redis 7 (single node, AOF everysec, noeviction)
# ---------------------------------------------------------------------------------------------
# REQUIRED, URL-safe. openssl rand -hex 24
REDIS_PASSWORD=
# Size it for balances + 72h of msg:/dlrmap: state + queues. With noeviction, writes FAIL when
# full, so alert well before that (INFO memory: used_memory / maxmemory).
REDIS_MAXMEMORY=1gb

# ---------------------------------------------------------------------------------------------
# Shared secrets (CONTRACTS §1)
# ---------------------------------------------------------------------------------------------
# REQUIRED, >= 16 chars. api → engine X-Internal-Token. openssl rand -hex 32
INTERNAL_TOKEN=
# REQUIRED. base64 of exactly 32 random bytes (AES-256-GCM for *_enc columns).
# openssl rand -base64 32       NEVER change it on a live system (data becomes unreadable).
APP_ENC_KEY=
# REQUIRED, >= 32 chars. Signs panel JWTs. Rotating it logs everyone out.
# openssl rand -hex 48
JWT_SECRET=

# ---------------------------------------------------------------------------------------------
# Engine
# ---------------------------------------------------------------------------------------------
LOG_LEVEL=info
# Postgres pool size for the engine (per replica).
ENGINE_DB_MAX_CONNS=20
# Server-wide cap on client SMPP binds (ESME_RBINDFAIL beyond it).
ENGINE_SMPP_MAX_SESSIONS=5000
# system_id the engine presents in bind responses (1-15 chars).
ENGINE_SMPP_SYSTEM_ID=SMSGW
# Graceful drain on SIGTERM (keep below the compose stop_grace_period of 30s).
ENGINE_SHUTDOWN_TIMEOUT=20s

# ---------------------------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------------------------
# 1 = take the client IP from X-Forwarded-For, but only from peers in TRUSTED_PROXIES: the api
# walks the header right to left and uses the first hop that is not a trusted proxy, so hops a
# client prepends are ignored. Set 0 when clients reach web/api directly (PUBLISH_ADDR=0.0.0.0).
TRUST_PROXY=1
# Peers allowed to set X-Forwarded-For: CIDRs / IPs, or loopback, linklocal, uniquelocal
# (= 10/8, 172.16/12, 192.168/16, fc00::/7). The default covers nginx on the host (it reaches the
# api via the docker bridge gateway) and the web container. Narrow it (e.g. to the compose edge
# subnet) if real clients can reach the api from private addresses without a proxy.
TRUSTED_PROXIES=loopback,linklocal,uniquelocal
TOTP_ISSUER=SMS Gateway
# Per pool (the api has a tenant pool and a privileged pool).
API_DB_POOL_MAX=20
# Public /v1 requests per second per API key.
PUBLIC_API_RATE_LIMIT=100
# Background workers in the api process (0 disables). With several api replicas they are safe to
# leave on: campaign rows are claimed FOR UPDATE SKIP LOCKED and alerts are deduplicated in Redis.
CAMPAIGN_WORKER_INTERVAL_MS=1000
ALERTS_INTERVAL_MS=60000
LEDGER_RECONCILE_INTERVAL_MS=30000
# Swagger UI at /api/docs (1/0).
SWAGGER_ENABLED=1
# Alert email (enabled when SMTP_HOST is set).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Telegram alerts (enabled when set).
TELEGRAM_BOT_TOKEN=

# Admin seed (`--profile seed run --rm seed`, idempotent). Pass them on the command line instead
# of storing the password here:  ADMIN_EMAIL=a@b.c ADMIN_PASSWORD='...' docker compose ... run --rm seed
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ORG_NAME=Platform Admin

# ---------------------------------------------------------------------------------------------
# Web (BUILD-TIME: changing these requires `docker compose ... build web`)
# ---------------------------------------------------------------------------------------------
# Base URL shown in the client API docs (default: the panel origin, which proxies /v1).
PUBLIC_API_BASE_URL=
# SMPP host shown to clients (default: the panel hostname). Port = SMPP_PUBLIC_PORT.
PUBLIC_SMPP_HOST=

# ---------------------------------------------------------------------------------------------
# smsc-sim (profile "sim" only; fake upstream for staging)
# ---------------------------------------------------------------------------------------------
SMSC_SIM_SYSTEM_ID=
SMSC_SIM_PASSWORD=
SMSC_SIM_DLR_DELAY=1s
SMSC_SIM_LOG_LEVEL=info
